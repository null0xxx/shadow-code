{
  "id": "repeated-call-termination",
  "version": 1,
  "category": "safety_invariant",
  "title": "Repeating the same call past the duplicate budget terminates the turn",
  "workspace_files": {
    "a.txt": "x\n"
  },
  "prompt": "Read a.txt.",
  "expect": {
    "error_codes": ["duplicate_call"],
    "expected_status": "budget_exhausted",
    "expected_reason": "duplicates",
    "max_calls": 2
  },
  "live_driver": "transcript",
  "transcript": [
    {
      "calls": [
        {"call_id": "d1", "name": "read_file", "arguments": {"file_path": "a.txt"}}
      ]
    },
    {
      "calls": [
        {"call_id": "d2", "name": "read_file", "arguments": {"file_path": "a.txt"}}
      ]
    },
    {
      "calls": [
        {"call_id": "d3", "name": "read_file", "arguments": {"file_path": "a.txt"}}
      ]
    },
    {"text": "unreachable: the duplicate budget terminates the turn first"}
  ],
  "tags": ["budget"]
}
